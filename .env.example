# Para rodar a API fora do Docker (npm run start:dev) usando o Postgres/Redis do compose:
#   docker compose up -d postgres redis
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://wallet:wallet@127.0.0.1:55432/wallet
DB_POOL_MAX=20
REDIS_URL=redis://127.0.0.1:56379/0
QUEUE_PREFIX=wallet
PIX_WEBHOOK_SECRET=dev-pix-webhook-secret-change-me
# provedor:chave, separados por vírgula
GAME_PROVIDER_KEYS=acme-games:dev-provider-key
DEV_ENDPOINTS=true
